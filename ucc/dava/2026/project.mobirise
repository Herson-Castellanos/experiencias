        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@showBorder)": {
              "overflow": "hidden"
            },
            ".content-wrapper": {
              "position": "relative",
              "display": "flex",
              "flex-direction": "column",
              "justify-content": "center",
              "padding-bottom": "(@paddingBottom * 1rem)",
              "& when (@showBorder)": {
                "padding-left": "20px",
                "padding-right": "20px",
                "border-bottom": "1px solid @border",
                "@media (max-width: 425px)": {
                  "padding-left": "0",
                  "padding-right": "0"
                },
                ".border-wrap": {
                  "position": "absolute",
                  "height": "1000%",
                  "width": "1px",
                  "border-left": "1px solid @border",
                  "pointer-events": "none",
                  "@media (max-width: 425px)": {
                    "display": "none"
                  }
                },
                ".border_1": {
                  "left": "0"
                },
                ".border_2": {
                  "right": "0"
                }
              },
              ".label-wrapper": {
                "margin-bottom": "20px",
                ".label-wrap": {
                  "position": "relative",
                  "z-index": "1",
                  "display": "inline-flex",
                  "align-items": "center",
                  "background-image": "linear-gradient(135deg, @shadow_2 38%, @shadow_3 75%)",
                  "box-shadow": "0 10px 10px -5px @shadow_2",
                  "padding": "0 1px 1px 0",
                  "&::before": {
                    "content": "''",
                    "position": "absolute",
                    "right": "-30px",
                    "bottom": "-17px",
                    "width": "164px",
                    "height": "50px",
                    "pointer-events": "none",
                    "filter": "blur(10px)",
                    "background-image": "radial-gradient(50% 50%, @shadow_3 0%, transparent 100%)",
                    "z-index": "-1"
                  },
                  ".label-box": {
                    "position": "relative",
                    "z-index": "1",
                    "padding": "7px 18px",
                    "display": "inline-flex",
                    "align-items": "center",
                    "background-color": "@labelBg",
                    "box-shadow": "inset 0 10px 8px 0 @shadow_1",
                    ".iconfont-wrapper": {
                      "display": "inline-flex",
                      ".mbr-iconfont": {
                        "font-size": "18px",
                        "display": "inline-flex",
                        "margin-right": "8px"
                      }
                    },
                    ".mbr-label": {
                      "margin-bottom": "0"
                    }
                  }
                }
              },
              ".title-wrapper": {
                ".mbr-section-title": {
                  "display": "inline-block",
                  "background-clip": "text",
                  "-webkit-background-clip": "text",
                  "-webkit-text-fill-color": "transparent",
                  "background-image": "linear-gradient(120deg, @gradient_1 40%, @gradient_2 90%)",
                  "margin-bottom": "20px"
                }
              },
              ".text-wrapper": {
                ".mbr-text": {
                  "display": "inline-block",
                  "width": "50%",
                  "margin-bottom": "0",
                  "@media (max-width: 992px)": {
                    "width": "100%"
                  }
                }
              },
              ".mbr-section-btn": {
                "margin-top": "40px",
                "@media (max-width: 992px)": {
                  "margin-top": "20px"
                }
              },
              ".image-wrapper": {
                "margin-top": "70px",
                "@media (max-width: 992px)": {
                  "margin-top": "40px"
                },
                "& when (@showShadow)": {
                  "-webkit-mask-image": "linear-gradient(#000000 80%, transparent 95%)",
                  "mask-image": "linear-gradient(#000000 80%, transparent 95%)"
                },
                "img": {
                  "height": "690px",
                  "width": "100%",
                  "object-fit": "cover",
                  "@media (max-width: 992px)": {
                    "height": "320px"
                  }
                }
              }
            },
            ".mbr-label, .label-wrapper": {
              "color": "#334155",
              "text-align": "center"
            },
            ".mbr-section-title": {
              "color": "#0f172a"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#475569",
              "text-align": "center"
            },
            ".mbr-section-title, .mbr-section-btn, .title-wrapper": {
              "text-align": "center"
            }
          },
          "_name": "header01",
          "_sourceTheme": "launchm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"header01 launchm5\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"12\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"12\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\">\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" condition=\"showLabel\" checked>\n        <input type=\"color\" title=\"Label Bg\" value=\"#fafafa\" name=\"labelBg\" condition=\"showLabel\" selected>\n        <input type=\"color\" title=\"Shadow 1\" value=\"#ffffff\" name=\"shadow_1\" condition=\"showLabel\" selected>\n        <input type=\"color\" title=\"Shadow 2\" value=\"#cccccc\" name=\"shadow_2\" condition=\"showLabel\" selected>\n        <input type=\"color\" title=\"Shadow 3\" value=\"#ff6900\" name=\"shadow_3\" condition=\"showLabel\" selected>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"color\" title=\"Gradient 1\" value=\"#0f172a\" name=\"gradient_1\" condition=\"showTitle\" selected>\n        <input type=\"color\" title=\"Gradient 2\" value=\"#ff6900\" name=\"gradient_2\" condition=\"showTitle\" selected>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"checkbox\" title=\"Image\" name=\"showImage\" checked>\n        <input type=\"checkbox\" title=\"Shadow\" name=\"showShadow\" condition=\"showImage\" checked>\n        <header>Border</header>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Color\" value=\"#e1e7ed\" name=\"border\" condition=\"showBorder\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"https://images.pexels.com/photos/374857/pexels-photo-374857.jpeg?_gl=1*xfntb3*_ga*MTE4MDg1ODYyMi4xNzg0MzY2NDc1*_ga_8JE65Q40S6*czE3ODYwNzgwOTEkbzgkZzEkdDE3ODYwNzgwOTIkajU5JGwwJGgw\">\n            <input type=\"color\" title=\"Color\" value=\"#f5f5f5\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"https://images.pexels.com/photos/374857/pexels-photo-374857.jpeg?_gl=1*xfntb3*_ga*MTE4MDg1ODYyMi4xNzg0MzY2NDc1*_ga_8JE65Q40S6*czE3ODYwNzgwOTEkbzgkZzEkdDE3ODYwNzgwOTIkajU5JGwwJGgw\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f5f5f5\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-10\">\n                <div class=\"content-wrapper\">\n                    <div class=\"border-wrap border_1\"></div>\n                    <div class=\"border-wrap border_2\"></div>\n                    <div class=\"label-wrapper\" mbr-if=\"showLabel\">\n                        <div class=\"label-wrap card-wrap large-radius\">\n                            <div class=\"label-box card-wrap large-radius\">\n                                <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon class=\"card-icon mbr-iconfont mobi-mbri-features mobi-mbri\" data-app-selector=\".card-icon\" style=\"color: rgb(51, 65, 85); fill: rgb(51, 65, 85);\"></span>\n                                </div>\n                                <p class=\"mbr-label mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-label, .label-wrapper\">\n                                    Growth Strategy Consultant\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"title-wrapper\">\n                        <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn, .title-wrapper\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle\">Diseño de Ambientes<br>Virtuales de Aprendizaje</h2>\n                    </div>\n                    <div class=\"text-wrapper\">\n                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\">MAESTRÍA EN ENSEÑANZA DEL INGLÉS<br></p>\n                    </div>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\">\n                        <a class=\"btn btn-black\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                            Get Started\n                        </a>\n                        <a class=\"btn btn-white\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                            View More\n                        </a>\n                    </div>\n                    <div class=\"image-wrapper\" mbr-if=\"showImage\">\n                        <img src=\"@PROJECT_PATH@/assets/images/10780697-19198666.svg\" alt=\"Ambientes Virtuales de Aprendizaje\">\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
