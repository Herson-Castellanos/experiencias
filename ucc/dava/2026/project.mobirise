                    "margin-bottom": "0",
                    "@media (max-width: 992px)": {
                      "width": "100%"
                    }
                  }
                }
              },
              ".google-map": {
                "iframe": {
                  "height": "400px",
                  "width": "100%",
                  "@media (max-width: 992px)": {
                    "height": "320px"
                  }
                }
              }
            },
            ".mbr-label, .label-wrapper": {
              "color": "#c55200",
              "text-align": "center"
            },
            ".mbr-section-title": {
              "color": "#0f172a",
              "text-align": "center"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#475569",
              "text-align": "justify"
            },
            ".mbr-section-title, .mbr-section-btn": {
              "text-align": "justify",
              "color": "#334155"
            }
          },
          "_name": "video01",
          "_sourceTheme": "launchm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"video01 launchm5\" group=\"Image & Video\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\" checked>\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" condition=\"showLabel\" checked>\n        <input type=\"color\" title=\"Label Bg\" value=\"#fafafa\" name=\"labelBg\" condition=\"showLabel\" selected>\n        <input type=\"color\" title=\"Shadow 1\" value=\"#ffffff\" name=\"shadow_1\" condition=\"showLabel\" selected>\n        <input type=\"color\" title=\"Shadow 2\" value=\"#cccccc\" name=\"shadow_2\" condition=\"showLabel\" selected>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <header>Border</header>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Color\" value=\"#e1e7ed\" name=\"border\" condition=\"showBorder\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f5f5f5\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f5f5f5\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-10\">\n                <div class=\"content-wrapper\">\n                    <div class=\"border-wrap border_1\"></div>\n                    <div class=\"border-wrap border_2\"></div>\n                    <div class=\"title-wrapper\" mbr-if=\"showLabel || showTitle || showText\">\n                        <div class=\"label-wrapper\" mbr-if=\"showLabel\">\n                            <div class=\"label-wrap card-wrap large-radius\">\n                                <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                                    <span mbr-icon class=\"card-icon mbr-iconfont fa-home fa\" data-app-selector=\".card-icon\" style=\"color: rgb(197, 82, 0); fill: rgb(197, 82, 0);\"></span>\n                                </div>\n                                <p class=\"mbr-label mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-label, .label-wrapper\">\n                                    Mensaje de bienvenida\n                                </p>\n                            </div>\n                        </div>\n                        <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><br>¡Qué gusto que estés aquí!<br></h2>\n                        <div class=\"text-wrapper\">\n                            <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\"><br>Te ofrezco una cálida bienvenida a esta nueva experiencia de aprendizaje, un espacio diseñado para repensar y transformar nuestra práctica docente, académica y educativa. Actualmente, la enseñanza de cualquier idioma —y disciplina— va más allá de los muros físicos del aula y nos exige implementar herramientas virtuales nuevas y actualizadas como una expansión de las posibilidades didácticas.<br></p>\n                        </div>\n                    </div>\n                    <div class=\"row items-wrapper justify-content-center\">\n                        <div class=\"col-12 col-lg-10 item\">\n                            <div mbr-video class=\"mbr-figure\">\n                                <iframe src=\"https://youtu.be/2-PO9iqvoA8?loop=1\"></iframe>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"text-wrapper\">\n                            <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\"><br>Durante las siguientes 5 semanas, nuestro objetivo será trascender el análisis de las bases teóricas del diseño instruccional, para concentrarnos en diseñar, desarrollar y evaluar secuencias didácticas, objetos&nbsp;y ambientes virtuales —flexibles— de aprendizaje virtuales, fundamentados en el Diseño Universal para el Aprendizaje, que respondan a la diversidad del estudiantado y que garanticen que el acceso al conocimiento sea equitativo.<br><br>Como profesional en la Enseñanza del Inglés, la apropiación de los Ambientes Virtuales de Aprendizaje (AVA) constituye una&nbsp;línea transversal de tu perfil de egreso; por lo que nos enfocaremos, a profundidad, en cómo la confianza, la interacción, la motivación y la accesibilidad aseguran entornos donde la adquisición de una segunda lengua florece de manera orgánica, derribando barreras geográficas.<br><br>Te invito a involucrarte de manera proactiva, a cuestionar los modelos sistémicos propuestos en el <a href=\"assets/files/programa_de_estudio_diseno_de_ambientes_virtuales_de_aprendizaje.pdf\" class=\"text-primary\" target=\"_blank\">Programa de estudio</a> y a forjar, mediante el diálogo académico y colaborativo, propuestas pedagógicas éticas, inclusivas y de vanguardia.<br><br>Gracias por tu atención y por formar parte de esta comunidad de investigación, desarrollo y praxis.<br></p>\n                        </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "vrAvQPqBTO",
          "_anchor": "video01-7",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".card-wrapper": {
              "padding": "60px 60px 0 60px",
              "border-bottom-left-radius": "0 !important",
              "border-bottom-right-radius": "0 !important",
              "background-color": "@cardBg",
              "box-shadow": "inset 0 10px 8px 0 @cardShadow_1, 1px 0 10px -5px @cardShadow_2",
              "overflow": "hidden",
              "margin-top": "-1px",
              "@media (max-width: 992px)": {
                "padding": "20px 20px 0 20px"
              },
              ".content-wrapper": {
                "margin-bottom": "60px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "40px"
                },
                ".title-wrapper": {
                  ".title-wrap": {
                    "display": "inline-flex",
                    "align-items": "center",
                    "gap": "10px",
                    "flex-wrap": "wrap",
                    "margin-bottom": "12px",
                    ".logo-wrapper": {
                      "img": {
                        "width": "30px",
                        "height": "30px",
                        "min-width": "30px",
                        "object-fit": "cover"
                      }
                    },
                    ".mbr-section-title": {
                      "margin-bottom": "0"
                    }
                  }
                },
                ".text-wrapper": {
                  ".mbr-text": {
                    "display": "inline-block",
                    "width": "80%",
                    "margin-bottom": "0",
                    "@media (max-width: 992px)": {
                      "width": "100%"
                    }
                  }
                },
                ".mbr-section-btn": {
                  "margin-top": "10px"
                }
              },
              ".nav-wrapper": {
                "display": "grid",
                "grid-template-columns": "1fr 1fr 1fr",
                "gap": "20px",
                "margin-bottom": "60px",
                "@media (max-width: 1440px)": {
                  "grid-template-columns": "1fr 1fr"
                },
                "@media (max-width: 992px)": {
                  "margin-bottom": "40px"
                },
                "@media (max-width: 768px)": {
                  "grid-template-columns": "1fr"
                },
                ".nav-wrap": {
                  ".mbr-list-title": {
                    "margin-bottom": "20px",
                    "@media (max-width: 992px)": {
                      "margin-bottom": "12px"
                    }
                  },
                  ".list": {
                    "padding": "0",
                    "margin": "0",
                    "list-style-type": "none",
                    "display": "flex",
                    "flex-direction": "column",
                    ".item-wrap": {
                      "position": "relative",
                      "margin-bottom": "16px",
                      "transition": "all 0.3s ease-in-out",
                      "display": "inline-flex",
                      "width": "fit-content",
                      "&::before": {
                        "content": "''",
                        "position": "absolute",
                        "bottom": "0",
                        "left": "0",
                        "width": "100%",
                        "height": "1px",
                        "background-color": "@activeNav",
                        "opacity": "0",
                        "transition": "all 0.3s ease-in-out",
                        "transform": "translateY(-2px)"
                      },
                      "&:hover, &:focus": {
                        "color": "@activeNav",
                        "&::before": {
                          "opacity": "1",
                          "transform": "translateY(0)"
                        }
                      },
                      "&:last-child": {
                        "margin-bottom": "0"
                      },
                      "@media (max-width: 992px)": {
                        "margin-bottom": "8px",
                        "&:last-child": {
                          "margin-bottom": "0"
                        }
                      }
                    }
                  }
                }
              },
              ".copy-wrap": {
                "position": "relative",
                "display": "flex",
                "justify-content": "center",
                "& when (@showCopy)": {
                  "padding": "20px 0"
                },
                ".border-wrap": {
                  "position": "absolute",
                  "top": "0",
                  "width": "1000%",
                  "height": "1px",
                  "background-color": "@border"
                },
                ".mbr-copy": {
                  "width": "100%",
                  "margin-bottom": "0"
                }
              }
            },
            ".mbr-section-title": {
              "color": "#0f172a"
            },
            ".mbr-text, .text-wrapper": {
              "color": "#475569"
            },
            ".mbr-list-title": {
              "color": "#475569"
            },
            ".list": {
              "color": "#0f172a"
            },
            ".mbr-copy": {
              "color": "#0f172a"
            }
          },
          "_name": "footer01",
          "_sourceTheme": "launchm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer01 launchm5\" group=\"Footer\" global once=\"footers\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"0\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"checkbox\" title=\"Navigation\" name=\"showNav\" checked>\n        <input type=\"checkbox\" title=\"Navigation Title\" name=\"showNavTitle\" checked condition=\"showNav\">\n        <input type=\"color\" title=\"Active Color\" value=\"#ff6900\" name=\"activeNav\" condition=\"showNav\" selected>\n        <input type=\"range\" inline title=\"Navigation Amount\" name=\"listAmount\" min=\"1\" max=\"3\" step=\"1\" value=\"3\" condition=\"showNav\">\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopy\" checked>\n        <input type=\"color\" title=\"Shadow 1\" value=\"#ffffff\" name=\"cardShadow_1\">\n        <input type=\"color\" title=\"Shadow 2\" value=\"#cccccc\" name=\"cardShadow_2\">\n        <input type=\"color\" title=\"Container BG\" value=\"#fafafa\" name=\"cardBg\" selected>\n        <header>Border</header>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Color\" value=\"#e1e7ed\" name=\"border\" condition=\"showBorder\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f5f5f5\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f5f5f5\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12 col-lg-11\">\n                <div class=\"card-wrapper\">\n                    <div class=\"row justify-content-center\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n                        <div class=\"col-12 col-lg-6\" mbr-if=\"showLogo || showTitle || showText || showButtons\">\n                            <div class=\"content-wrapper\">\n                                <div class=\"title-wrapper\">\n                                    <div class=\"title-wrap\">\n                                        <div class=\"logo-wrapper\" mbr-if=\"showLogo\">\n                                            <img class=\"little-radius\" src=\"../_images/logo.png\" alt=\"Mobirise Website Builder\">\n                                        </div>\n                                        <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn, .title-wrapper\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\">\n                                            <b>Diseño de Ambientes Virtuales de Aprendizaje</b></h2>\n                                    </div>\n                                </div>\n                                <div class=\"text-wrapper\">\n                                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .text-wrapper\">\n                                        Experiencia de Aprendizaje<br>Maestría en Enseñanza del Inglés<br>Modalidad Mixta<br>Universidad Cristóbal Colón</p>\n                                </div>\n                                <div class=\"mbr-section-btn item-footer\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\">\n                                    <a href class=\"btn btn-black\" data-app-placeholder=\"Type Text\">\n                                        Get Started\n                                    </a>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-12 col-lg-6\" mbr-if=\"showNav\">\n                            <div class=\"nav-wrapper\">\n                                <div class=\"nav-wrap\">\n                                    <h4 class=\"mbr-list-title mbr-fonts-style\" data-app-selector=\".mbr-list-title\" mbr-theme-style=\"display-4\" mbr-if=\"showNavTitle\">\n                                        Navegación</h4>\n                                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                        <li class=\"item-wrap\"><a href=\"index.html#header01-1\" class=\"text-primary\">Bienvenida</a></li>\n                                        <li class=\"item-wrap\">Dinámica</li>\n                                    </ul>\n                                </div>\n                                <div class=\"nav-wrap\" mbr-if=\"listAmount > 1\">\n                                    <h4 class=\"mbr-list-title mbr-fonts-style\" data-app-selector=\".mbr-list-title\" mbr-theme-style=\"display-4\" mbr-if=\"showNavTitle\">\n                                        Contacto</h4>\n                                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                        <li class=\"item-wrap\"><a href=\"mailto:herson.castellanos@icloud.com?subject=Dise%C3%B1o%20de%20Ambientes%20Virtuales%20de%20Aprendizaje\" class=\"text-primary\">Correo</a></li><li class=\"item-wrap\"><a href=\"tg://resolve?domain=https://t.me/+Xgl6N7AZcRo5M2Qx\" class=\"text-primary\">Mensajes</a></li>\n                                    </ul>\n                                </div>\n                                <div class=\"nav-wrap\" mbr-if=\"listAmount > 2\">\n                                    <h4 class=\"mbr-list-title mbr-fonts-style\" data-app-selector=\".mbr-list-title\" mbr-theme-style=\"display-4\" mbr-if=\"showNavTitle\">Sitios de interés</h4>\n                                    <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list, .item-wrap\" data-multiline mbr-article>\n                                        <li class=\"item-wrap\"><a href=\"https://www.ucc.mx\" class=\"text-primary\" target=\"_blank\">UCC</a></li>\n                                        <li class=\"item-wrap\"><a href=\"https://www.ucc.mx/ucc_mastery/ensenanza-del-ingles/\" class=\"text-primary\" target=\"_blank\">MEI</a></li><li class=\"item-wrap\"><a href=\"https://apastyle.apa.org\" target=\"_blank\" class=\"text-primary\">APAStyle</a></li>\n                                    </ul>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"col-12\" mbr-if=\"showCopy || showBorder\">\n                            <div class=\"copy-wrap\">\n                                <div class=\"border-wrap\" mbr-if=\"showBorder\"></div>\n                                <p class=\"mbr-copy mbr-fonts-style visible\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-copy\">\n                                    © Copyright 2030 Mobirise - All Rights Reserved\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "vrA3aUavhg",
          "_anchor": "footer01-2",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {}
        }
      ]
    }
  }
}